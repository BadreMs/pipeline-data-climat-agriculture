# Nom de projet Docker Compose (evite les soucis lies aux espaces/& du dossier racine)
COMPOSE_PROJECT_NAME=pipeline-data-climat-agriculture

# --- Postgres (instance unique, 2 bases : airflow + dwh) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=changeme
POSTGRES_DWH_DB=dwh
POSTGRES_AIRFLOW_DB=airflow

# --- dbt (cible = base dwh) ---
DBT_PROFILES_DIR=./dbt_project
DBT_TARGET=dev

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__WEBSERVER__DEFAULT_USER_USERNAME=admin
AIRFLOW__WEBSERVER__DEFAULT_USER_PASSWORD=admin

# --- Ingestion Open-Meteo ---
OPENMETEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPENMETEO_START_DATE=2015-01-01
OPENMETEO_END_DATE=

# --- Ingestion data.gov.ma ---
DATAGOVMA_AGRICULTURE_URL=
DATAGOVMA_IRRIGATION_URL=
DATAGOVMA_BARRAGES_URL=
DATAGOVMA_USE_MOCK_FALLBACK=true

# --- Adminer (optionnel) ---
ADMINER_PORT=8081
